<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Task #<%= task.id %> Details</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            padding: 30px;
        }
        .card {
            max-width: 500px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }
        a {
            display: inline-block;
            margin-top: 15px;
            color: #1e3a5f;
            text-decoration: none;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="card">
        <h2>Task Details (URL Parameter Demo)</h2>
        <p><strong>Task ID:</strong> <%= task.id %></p>
        <p><strong>Title:</strong> <%= task.title %></p>
        <p><strong>Status:</strong> <%= task.status %></p>
        <a href="/">&larr; Back to All Tasks</a>
    </div>
</body>
</html>
